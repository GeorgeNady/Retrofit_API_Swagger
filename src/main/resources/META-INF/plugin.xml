<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.georgenady.api_swagger</id>
    <name>Api Swagger</name>
    <vendor>George Nady</vendor>
    <vendor
            url="https://github.com/GeorgeNady"
            email="gorgonady.gn@gmail.com">
        George Nady
    </vendor>
    <version>1.1.8</version>
    <description><![CDATA[
        <p><b>Api Swagger</b> is a professional tool for visualizing and managing your Android network layer. It provides a visual "Design Mode" similar to the Jetpack Navigation Editor, tailored for Retrofit APIs.</p>

        <h3>🚀 Key Features</h3>
        <ul>
            <li><b>Interactive Node Graph:</b> Visualize your service-to-endpoint relationships with a draggable and zoomable canvas.</li>
            <li><b>Dual View Modes:</b> Toggle between a high-level visual graph and a detailed, searchable card list.</li>
            <li><b>Deep Inspection:</b> Automatically extracts annotations (including custom ones like @SupportCache), method signatures, and parameters.</li>
            <li><b>Powerful Filters:</b> Live search by path or method name, and filter by HTTP method or module scope.</li>
            <li><b>Design Tools:</b> Includes a floating design toolbar with a hand-pan tool, zoom controls, and fit-to-screen functionality.</li>
        </ul>

        <h3>🛠️ Built for Modern Android</h3>
        <ul>
            <li>Full support for Kotlin K2 mode.</li>
            <li>Robust discovery in complex multi-module Gradle projects.</li>
            <li>Themed UI that respects Darcula and Light modes.</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>
    <depends>org.jetbrains.kotlin</depends>

    <resource-bundle>messages.MyBundle</resource-bundle>

    <actions>
        <action id="ApiSwagger.Refresh"
                class="com.github.georgenady.rettrofitapigraph.presentation.main.actions.RefreshAction"
                text="Refresh APIs List"
                description="Scan project for Retrofit endpoints"
                icon="AllIcons.Actions.Refresh" />
        <action id="ApiSwagger.ToggleSidePanel"
                class="com.github.georgenady.rettrofitapigraph.presentation.main.actions.ToggleSidePanelAction"
                text="Toggle Side Panel"
                description="Show or hide the feature panel"
                icon="AllIcons.General.Filter" />
        <action id="ApiSwagger.SwitchView"
                class="com.github.georgenady.rettrofitapigraph.presentation.main.actions.SwitchViewModeAction"
                text="Switch View Mode"
                description="Toggle between List, and Graph views"
                icon="AllIcons.Actions.Diff" />
    </actions>

    <extensions defaultExtensionNs="com.intellij">
        <projectService serviceInterface="com.github.georgenady.rettrofitapigraph.domain.repository.ApiRepository"
                        serviceImplementation="com.github.georgenady.rettrofitapigraph.data.repository.ApiRepositoryImpl"/>
        <projectService serviceImplementation="com.github.georgenady.rettrofitapigraph.presentation.main.MainToolViewModel"/>
        <applicationService serviceImplementation="com.github.georgenady.rettrofitapigraph.presentation.panels.swaggerPanel.SwaggerPanelViewModel"/>

        <toolWindow factoryClass="com.github.georgenady.rettrofitapigraph.presentation.main.MainToolWindowFactory"
                    id="ApiSwagger"
                    name="Api Swagger"
                    anchor="right"
                    icon="AllIcons.Nodes.PpLib"/>

        <fileEditorProvider implementation="com.github.georgenady.rettrofitapigraph.editor.provider.DataSourcePreviewEditorProvider"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>
</idea-plugin>
